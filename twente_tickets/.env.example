# Kopieer naar .env en vul in. .env wordt NIET gecommit.
TWENTE_EMAIL=
TWENTE_PASSWORD=
EVENT_URL=https://kaartverkoop.fctwente.nl/events/home/FC_Twente-Ajax

# Vakken/tribunes die je wilt (komma-gescheiden, hoofdletterongevoelig).
# Pas aan na de eerste 'discover'-run, als je ziet hoe de site ze noemt.
SECTION_KEYWORDS=West,Oost,Lange zijde,Ring 1,Onder
SEATS_NEEDED=2

# Interval in seconden (er komt willekeurig 0-30s bij). Niet te laag: kans op blokkade.
POLL_SECONDS=60

# Alerts: ntfy.sh (gratis, installeer de ntfy-app en abonneer op dit topic).
# Kies een lang, onraadbaar topic.
NTFY_TOPIC=
# Optioneel ook Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
